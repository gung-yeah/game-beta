{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gung-yeah.github.io/game-beta/qa/BUG_REPORT.schema.json",
  "title": "골든 라이프 베타 BUG_REPORT",
  "type": "object",
  "required": ["schema", "game_version", "tester", "tested_at", "environments", "bugs", "suggestions", "retest"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "golden-life-bug-report/v1" },
    "game_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "시작 화면 「베타 테스트 vX.Y.Z」의 X.Y.Z" },
    "tester": { "type": "string", "description": "테스터 이름 (회차 폴더 끝과 같게)" },
    "tested_at": { "type": "string", "format": "date-time" },
    "environments": {
      "type": "array",
      "minItems": 1,
      "description": "이번 회차에 시험한 환경 목록",
      "items": { "$ref": "#/$defs/environment" }
    },
    "bugs": { "type": "array", "items": { "$ref": "#/$defs/bug" } },
    "suggestions": { "type": "array", "items": { "$ref": "#/$defs/suggestion" } },
    "retest": {
      "type": "array",
      "description": "이전 회차 버그를 다시 확인한 결과",
      "items": {
        "type": "object",
        "required": ["ref", "result"],
        "additionalProperties": false,
        "properties": {
          "ref": { "type": "string", "description": "<회차 폴더>/BUG-xxx" },
          "result": { "enum": ["fixed", "still_broken", "cannot_check"] },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "area": {
      "enum": ["title", "adopt", "hub", "puzzle", "helper", "story", "merge", "outing", "shop", "decorate", "bag", "attendance", "wish", "sound", "save", "other"]
    },
    "environment": {
      "type": "object",
      "required": ["viewport", "orientation", "color_scheme", "browser"],
      "additionalProperties": false,
      "properties": {
        "viewport": { "type": "string", "pattern": "^\\d+x\\d+$", "description": "예: 390x844" },
        "orientation": { "enum": ["portrait", "landscape"] },
        "color_scheme": { "enum": ["light", "dark"] },
        "browser": { "type": "string", "description": "예: Chromium 130 (headless, touch)" },
        "device_name": { "type": "string" }
      }
    },
    "bug": {
      "type": "object",
      "required": ["id", "title", "severity", "category", "area", "steps", "expected", "actual", "reproducible", "environment", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^BUG-\\d{3}$" },
        "title": { "type": "string", "description": "한 줄 요약" },
        "severity": { "enum": ["critical", "major", "minor", "trivial"] },
        "category": { "enum": ["crash", "logic", "ui", "layout", "text", "sound", "performance", "balance", "save", "accessibility", "data"] },
        "area": { "$ref": "#/$defs/area" },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "처음 상태부터 재현 단계" },
        "expected": { "type": "string" },
        "actual": { "type": "string" },
        "reproducible": { "enum": ["always", "sometimes", "once"] },
        "repro_rate": { "type": "string", "description": "예: 3/3" },
        "environment": { "$ref": "#/$defs/environment" },
        "start_state": { "type": "string", "description": "처음부터 / 저장 상태 파일(evidence/...)에서 / 테스트 도구 사용 등" },
        "console_errors": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string", "description": "회차 폴더 기준 경로, 예: evidence/BUG-001_1.png" } },
        "suggestion": { "type": "string", "description": "고치는 방향 제안 (글로만)" },
        "seen_before": { "type": "string", "description": "<회차 폴더>/BUG-xxx" }
      }
    },
    "suggestion": {
      "type": "object",
      "required": ["id", "title", "area", "detail", "priority"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^IDEA-\\d{3}$" },
        "title": { "type": "string" },
        "area": { "$ref": "#/$defs/area" },
        "detail": { "type": "string", "description": "무엇을 왜 바꾸면 좋은지" },
        "priority": { "enum": ["high", "medium", "low"] },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
